[Unit]
Description=Rclone Google Drive High-Performance Mount (/srv/gdrive)
Documentation=man:rclone(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/src/gdrive/gdrive-mount.sh start
ExecStop=%h/.local/src/gdrive/gdrive-mount.sh stop
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
Environment=RCLONE_REMOTE=gdrive:
Environment=RCLONE_MOUNT_POINT=/srv/gdrive

[Install]
WantedBy=default.target
